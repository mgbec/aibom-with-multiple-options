{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AIBOMReportsS3AccessWest",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject",
                "s3:GetObjectVersion",
                "s3:PutObjectAcl",
                "s3:GetObjectAcl"
            ],
            "Resource": [
                "arn:aws:s3:::aibom-reports-339712707840-us-west-2/*"
            ]
        },
        {
            "Sid": "AIBOMReportsS3BucketAccessWest",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket",
                "s3:GetBucketLocation",
                "s3:GetBucketVersioning",
                "s3:HeadBucket"
            ],
            "Resource": [
                "arn:aws:s3:::aibom-reports-339712707840-us-west-2"
            ]
        }
    ]
}