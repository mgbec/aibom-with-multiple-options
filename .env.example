# AWS Configuration
AWS_REGION=us-east-1
AWS_BEDROCK_AGENT_ID=
AWS_BEDROCK_AGENT_ALIAS_ID=TSTALIASID
AWS_AIBOM_S3_BUCKET=

# Hugging Face Configuration
HF_TOKEN=
HF_CACHE_DIR=./cache/huggingface

# AIBOM Generator Configuration
AIBOM_OWASP_AIBOM_GENERATOR_PATH=./tools/owasp-aibom-generator
AIBOM_OUTPUT_FORMAT=json
AIBOM_INCLUDE_DEPS=true

# Application Configuration
DEBUG=false
LOG_LEVEL=INFO
OUTPUT_DIR=./reports
TEMP_DIR=./tmp