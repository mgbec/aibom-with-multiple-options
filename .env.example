# AWS Configuration
AWS_REGION=us-west-2
AIBOM_S3_BUCKET=aibom-reports-339712707840-us-west-2
S3_ENCRYPTION=true

# Hugging Face Configuration
HF_TOKEN=your_huggingface_token_here
HF_CACHE_DIR=./cache/huggingface

# Application Configuration
DEBUG=false
LOG_LEVEL=INFO
OUTPUT_DIR=./reports
TEMP_DIR=./tmp

# AIBOM Generator Configuration
OWASP_AIBOM_GENERATOR_PATH=./tools/owasp-aibom-generator
AIBOM_OUTPUT_FORMAT=json
AIBOM_INCLUDE_DEPS=true